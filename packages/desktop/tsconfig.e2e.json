{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,

    // An end-to-end spec is the one place code for both processes sits in one
    // file: the spec body is Node, and every `window.evaluate` callback is
    // serialised and run inside Chromium. So this is the only config that needs
    // both `node` and DOM — which is exactly why it is separate from the
    // main-process config, where a stray `document` should still be an error.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["test/e2e/**/*", "src/preload/operations.ts"]
}
