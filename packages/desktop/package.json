{
  "name": "@grndctrl/desktop",
  "version": "0.2.0",
  "description": "The Electron application: main, preload, and the React renderer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "native": "node scripts/fetch-native.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.e2e.json",
    "watch": "node scripts/build.mjs --watch",
    "dev": "npm run native && npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@grndctrl/core": "*",
    "@playwright/test": "^1.48.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist",
    "native/requirements.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonupchurch/grndctrl.git",
    "directory": "packages/desktop"
  },
  "homepage": "https://github.com/jonupchurch/grndctrl#readme"
}
