{
  // The launcher's tests were not typechecked by anything until T160. Its
  // `tsconfig.json` includes `src/**/*` only, which is the same trap the
  // desktop package has with `tsconfig.ui.json`: a clean typecheck of the wrong
  // project is not a typecheck, and it reads as one.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2023"]
  },
  "include": ["test/**/*", "src/**/*"]
}
